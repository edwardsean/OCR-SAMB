  "cards": [
    {
      "dot": "emerald",
      "title": "Why Jev goes before the VLM",
      "items": [
        "Type picks the field schema and the customer profile before the expensive call",
        "Jev reads the classical OCR text, so it never needs the image"
      ]
    },
    {
      "dot": "cyan",
      "title": "What 'verify' means, exactly",
      "items": [
        "Every value the VLM returns must be found in the classical OCR text of the same page",
        "Only the values that fail go to a second model of a different family"
      ]
    },
    {
      "dot": "violet",
      "title": "Why grouping waits for N of N",
      "items": [
        "A page worker cannot see other pages; pages → documents → SOR needs all of them",
        "TTG and PO find their SOR by PO No through Satellite, so scan order does not matter"
      ]
    },
    {
      "dot": "amber",
      "title": "What the person sees",
      "items": [
        "One SOR at a time, only when a cross-check failed",
        "The fix republishes that bundle; nothing upstream re-runs"
      ]
    }
  ]
