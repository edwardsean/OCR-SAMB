// SAMB OCR · 2 of 6 · PAGES TOGETHER BY ORDER, CHECKED, REVIEWED, PUBLISHED. Written for non-technical readers.
// For maintainers: grouper/serve.py, grouper/group.py, grouper/crosscheck.py, grouper/matching.py, ui/app.py (Review),
// publisher/publish.py, common/notice.py.

title Putting each order's papers together, checking them, Review, publishing
direction down

Colours [shape: document, color: gray, icon: info, label: "How to read the colours. Green: simple rules. Blue: an AI does it. Orange: a person. Red: set aside, never guessed. Gray: storage, waiting or information only"]

vf grouper [color: gray, icon: cpu, label: "The grouper takes the finished pages of a batch, one batch at a time"]

Grouping [color: green, label: "Putting pages together by order"] {
  Resolved keys [icon: key, label: "A page joins an order only through a confirmed number: confirmed by the paper, the QR code, Satellite or a person. A number only the AI read has to wait"]
  FP is the hub [icon: link, label: "SAMB's invoice is the center. It prints the order number and the customer's PO number. A goods receipt joins by the order number it prints, or by the PO number. A customer's PO joins by its PO number"]
  Continuations [icon: corner-down-right, label: "A next page of a document joins the page before it. This is the only time the page order is used"]
  Holds [color: red, icon: pause-circle, label: "Never guessed. A page is set aside when its number isn't confirmed, when two numbers point to different orders, when a PO number fits several orders, or when the order has no invoice yet"]
  Folders [shape: cylinder, color: gray, label: "Each order gets a folder with its pages. Pages set aside go to a separate folder"]
}

Knowledge regroup [color: gray, icon: book, label: "If a page was filled in with another customer's tips than its order's, it is filled in again with the right tips, then grouped again"]

Cross checks 7c [color: green, label: "Checking the order's papers against Satellite"] {
  SO in Satellite [label: "The order exists in Satellite"]
  Docs complete [label: "All expected papers are there, usually the invoice and the goods receipt"]
  Order side [label: "ORDER: the PO's total matches SAMB's order, allowing the customer's few rupiah of rounding"]
  Delivery side [label: "DELIVERY: the quantities on the goods receipt match what SAMB's warehouse recorded as received. Less than ordered is a rejection (tolakan), shown with its reason"]
  Rows explain [label: "The product lines are matched to SAMB's lines, but only to explain a difference"]
  Store named [label: "If a page names a store, it must be this order's store. This catches a paper linked to another store's order"]
  Dates [label: "The dates are in a sensible order, and the receipt date matches the warehouse's date"]
  Calibration [label: "A new customer's first order: a person confirms, once, how much rounding is normal and what its receipts print"]
  Ask again [color: blue, label: "A number that doesn't match and that only the AI read: the AI reads it again first"]
}

Status [shape: diamond, color: green, label: "The result for this order"]
Grouping status [shape: oval, color: gray, label: "Still waiting, for the AI or for the warehouse record"]
Auto ok [shape: oval, color: green, label: "Everything matches. No person needed"]
Needs review [shape: oval, color: orange, label: "Something doesn't match: it goes to the Review screen"]

Notify [color: gray, icon: bell, label: "Every 5 minutes, new orders that need a person show up as a red number on the Review tab"]

What reaches Review [color: orange, label: "What a person sees on Review"] {
  Open check [icon: alert-triangle, label: "A check that doesn't match: both amounts, the difference, and the lines that cause it"]
  First look [icon: user-check, label: "A new customer's one-time questions"]
  Holding page [icon: file, label: "A page that holds up the order: its number, an invoice amount, or a value where the paper and Satellite disagree"]
  Missing doc [icon: file-minus, label: "A paper that is missing"]
  Waiting info [color: gray, icon: clock, label: "Waiting for the AI or for Satellite: just for information, nothing to do"]
  Not reviewed [color: gray, icon: eye-off, label: "NEVER sent to a person: values that are only stored, Tesseract simply not being able to read something, or quantities in a table on their own"]
}

How to review [color: orange, label: "What a person can do on Review"] {
  Accept [icon: check, label: "Accept a difference, with a reason, in one click"]
  Fix number [icon: edit-3, label: "Fix a misread number: type it, or click it on the page"]
  Not printed [icon: slash, label: "Say that a value isn't printed on this page"]
  Calibrate [icon: sliders, label: "Set a customer's normal rounding and what its receipts print. Once per customer"]
  Pair rows [icon: shuffle, label: "Match a customer's product line to SAMB's product. It is remembered for next time"]
  Approve [icon: thumbs-up, label: "Approve the order, once nothing is left to decide"]
}

After a fix [color: green, icon: rotate-cw, label: "After a fix, the page is checked again and the order is regrouped and rechecked, at no AI cost. The fix is also kept as an example to learn from (diagram 3)"]

Publish [color: green, label: "Publishing"] {
  Publish button [color: orange, icon: upload-cloud, label: "A person presses Publish. Only orders that passed, or that a person approved"]
  Satellite rows [shape: cylinder, color: gray, label: "The values are written into Satellite"]
  SOR pdf [shape: document, color: gray, label: "One PDF per order, with all its pages"]
  Never again [label: "A published order is not checked again"]
}

vf grouper > Resolved keys
Resolved keys > FP is the hub
FP is the hub > Continuations
Continuations > Holds: number missing or conflicting
Continuations > Folders
Folders > Knowledge regroup
Knowledge regroup > SO in Satellite
SO in Satellite > Docs complete
Docs complete > Order side
Order side > Delivery side
Delivery side > Rows explain
Rows explain > Store named
Store named > Dates
Dates > Calibration
Calibration > Ask again: a number only the AI read doesn't match
Ask again --> vf grouper: the page is read again, then regrouped
Calibration > Status
Holds > Status
Status > Grouping status
Status > Auto ok
Status > Needs review
Needs review > Notify
Notify > Open check
Needs review > Open check
Needs review > First look
Needs review > Holding page
Needs review > Missing doc
Grouping status > Waiting info
Open check > Accept
Open check > Fix number
Holding page > Fix number
Holding page > Not printed
First look > Calibrate
Open check > Pair rows
Accept > Approve
Fix number > After a fix
Not printed > After a fix
Calibrate > After a fix
Pair rows > After a fix
After a fix --> vf grouper
Approve > Publish button
Auto ok > Publish button
Publish button > Satellite rows
Publish button > SOR pdf
Satellite rows > Never again
