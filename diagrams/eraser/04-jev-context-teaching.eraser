// SAMB OCR · 4 of 6 · TEACHING JEV TO RECOGNISE DOCUMENT TYPES. Written for non-technical readers.
// For maintainers: ui/app.py (/label, /context), worker/lesson.py (serve, run, replay), common/context.py,
// common/models/teacher.py.

title Teaching Jev to recognise document types
direction down

Colours [shape: document, color: gray, icon: info, label: "How to read the colours. Orange: a person. Green: simple rules. Blue: an AI. Purple: Jev's descriptions of the document types. Gray: storage. Red: refused"]

Unsure page [shape: oval, color: orange, icon: help-circle, label: "A page Jev wasn't sure about"]

Label [color: orange, label: "A person labels the page"] {
  Label screen [icon: tag, label: "On the Label screen, a person picks the document type. The machine's guess is hidden, so it can't sway them"]
  Type label [shape: cylinder, color: gray, label: "The label is saved, and put once, at random, in the practice pile (80%) or the test pile (20%)"]
  Resume [color: green, icon: play, label: "The page carries on with its label: read, checked and grouped like any other page"]
}

Lesson made [shape: diamond, color: green, label: "Is it in the practice pile, and was Jev unsure or wrong?"]
Exam only [color: gray, icon: lock, label: "Test pile: never taught. Used afterwards to measure"]
Lesson [shape: cylinder, color: gray, label: "A lesson is saved, and the teacher is woken up"]

vf teacher [color: blue, label: "The teacher (an AI)"] {
  One consumer [icon: cpu, label: "One teacher handles one lesson at a time, oldest first. It also checks every 30 minutes"]
  Pending [shape: diamond, color: green, label: "Is a change already waiting for approval? Then wait: one change at a time"]
  Already fixed [shape: diamond, color: green, label: "Does a newer version of the descriptions already get this page right?"]
  Closed [shape: oval, color: gray, label: "Yes: the lesson is closed, nothing to ask"]
  GLM vision [icon: eye, label: "The teacher, an AI that can see images, looks at the page, the label, and Jev's descriptions, and explains why Jev missed it"]
  One change [icon: edit, label: "It proposes ONE change to the descriptions. For example, a title this type of document prints, or what it is not"]
}

Code rules [color: red, label: "Simple rules"] {
  Refuse [icon: x-octagon, label: "Simple rules refuse a change that adds nothing new, is too long, or uses a value not printed on the page"]
  Second try [icon: repeat, label: "Refused or not good enough: the teacher gets one more try and is told why"]
}

Replay [color: green, label: "Testing the change"] {
  Replay on labels [icon: rewind, label: "Test: Jev is asked again about every practice page, once with the old descriptions and once with the new ones"]
  Rule [shape: diamond, label: "Kept only if more pages are right, none is newly wrong, and fewer are unsure"]
}

Context screen [color: orange, label: "A person decides"] {
  Proposal shown [icon: git-pull-request, label: "The Context screen shows the change, the page, the teacher's reason and the test result"]
  Stale [color: red, icon: alert-triangle, label: "Made from an older version? It can't be approved, because it would undo later changes"]
  Approve [icon: thumbs-up, label: "Approve: the new version is used from now on"]
  Reject [icon: thumbs-down, label: "Or reject it"]
}

Effect [color: purple, label: "What changes"] {
  Active context [shape: document, icon: book-open, label: "Jev now uses the new descriptions"]
  Jev reruns [icon: refresh-cw, label: "Pages are sorted again with the new version the next time they run"]
  New field [icon: plus-square, label: "If a new field was added, pages are filled in again from their saved copy. The image isn't read again"]
  Exam score [color: gray, icon: bar-chart-2, label: "The test pile is measured with the new version"]
  Aliases [color: gray, icon: bookmark, label: "Fixed facts, like a customer's own name for a document, are stored as data, not in the descriptions"]
}

Unsure page > Label screen
Label screen > Type label
Type label > Resume
Type label > Lesson made
Lesson made > Exam only: test pile
Lesson made > Lesson: yes
Lesson > One consumer
One consumer > Pending
Pending > Already fixed: no
Already fixed > Closed: yes
Already fixed > GLM vision: no
GLM vision > One change
One change > Refuse
Refuse > Second try: refused
Second try --> GLM vision
Refuse > Replay on labels: passes the rules
Replay on labels > Rule
Rule > Second try: not good enough
Rule > Proposal shown: kept
Proposal shown > Stale
Proposal shown > Approve
Proposal shown > Reject
Approve > Active context
Reject --> One consumer: next lesson
Approve --> One consumer: next lesson
Active context > Jev reruns
Active context > New field
Active context > Exam score
Exam only --> Exam score
