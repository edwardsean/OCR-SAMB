# Copy to .env (cp .env.example .env) and fill in the keys you have. This lists every setting the code and
# docker-compose.yml read. A line left commented out keeps the default shown, which is this repo's own setup.
# The passwords below are dev defaults only: never reuse them outside your laptop. .env itself is never committed.

# ================================================================= servers (Postgres, RabbitMQ, MinIO)
POSTGRES_USER=ocr
POSTGRES_PASSWORD=ocr_dev_pw
# v1's database, read-only here (MAIN_DATABASE_URL)
POSTGRES_DB=ocr
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

RABBITMQ_USER=ocr
RABBITMQ_PASSWORD=ocr_dev_pw
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_PORT=5672

MINIO_ROOT_USER=ocr
MINIO_ROOT_PASSWORD=ocr_dev_pw_minio
MINIO_BUCKET=scans
# MINIO_ENDPOINT=minio:9000
# MINIO_SECURE=false                  # true for TLS (S3, Alibaba OSS)

# The Docker network the servers run on (this compose file joins it; start the servers first).
# DOCKER_NETWORK=samb-ocr_default
# Where docker-compose.servers.yml publishes the servers on this computer:
# POSTGRES_HOST_PORT=55432
# RABBITMQ_HOST_PORT=5672
# RABBITMQ_CONSOLE_PORT=15672
# MINIO_HOST_PORT=9000
# MINIO_CONSOLE_PORT=9001

# ================================================================= this stack
# PIPELINE_DB=ocr_rtm                 # this stack's own database on the Postgres server
# RABBITMQ_VHOST=rtm
# STORAGE_PREFIX=rtm/                 # where this stack writes in the bucket
# SERVICE_PREFIX=rtm                  # its services' names: rtm-worker, rtm-api, … (the Status page probes them)
# PIPELINE=vlm-first
# IMAGE_PREFIX=samb-ocr               # Docker image names: <prefix>-worker, <prefix>-api, <prefix>-web
# WORKER_REPLICAS=3                    # page workers; each reads WORKER_CONCURRENCY pages at once
# WORKER_CONCURRENCY=4                 # pages per worker until one is saved on Teknis → Model & kunci API (~1 GB at 4)
# TESSERACT_AT_ONCE=1                  # pages Tesseract reads at once per worker (the CPU-heavy part)
# INTAKE_REPLICAS=1                  # intake workers: each splits one uploaded scan at a time
# HEALTH_PORT=8080                    # where each worker answers /health
# RENDER_WORKERS=6                    # pages rendered at once when a scan is split (CPU cores)

# ================================================================= addresses
# API_PORT=8002                       # the API (services/api) on this computer
# WEB_PORT=3002                       # the web app (frontend/) on this computer: where people work
# WEB_URL=http://localhost:3002       # a browser opening the API's own address is sent here
# RABBITMQ_CONSOLE_URL=http://localhost:15672            # links on the Status page, opened from a browser
# MINIO_CONSOLE_URL=http://localhost:9001

# ================================================================= the scheduler's jobs (services/scheduler), in minutes
# INTAKE_RETRY_MINUTES=10             # a scan received but not split yet goes back on q.intake
# NOTIFY_EVERY_MINUTES=5              # orders that newly need a person become a notice
# SWEEP_EVERY_MINUTES=180             # pages still waiting for the AI go back on the queue
# LINT_EVERY_MINUTES=360              # knowledge a person's later correction contradicts is taken out
# TRACE_KEEP_DAYS=90                   # the trace (Teknis → Jejak, Metrik) keeps this many days
# PAYLOAD_KEEP_DAYS=14                 # each AI call's exact request and response (~100 KB a page)

# ================================================================= sample data (real customer documents: never committed)
# SAMPLE_DIR=./testdata               # the folder holding sample.pdf, the 288-page sample scan (the tests that read it
#                                     # skip without it)
# GOLDEN_FILE=7000356304 - 7000356499.pdf   # the scan the answer key (testdata/golden_p1-32.json) grades
# TESTDATA_DIR=                        # where golden_p1-32.json is (found beside the code when empty)

# ================================================================= models
# The vision model, the text model and the classification model are set ONLY on the web app's Teknis -> Model & kunci
# API (/settings): an endpoint, its API key and a model for each. Nothing here: until they are set there, no page is
# read (pages wait, then go on by themselves).
# JEV_AT_ONCE=6                       # pages asked at once when the page-type teacher tests a change
# VF_READER=two_step                  # one_step (read the fields) or two_step (transcribe everything, then map)
# VF_MAP_TWICE=1
# VF_AI_OCR_DAILY_CAP=20000           # calls a day this system allows itself, per model (a runaway guard)
# VF_AI_MAP_DAILY_CAP=40000
# VF_WAIT_MINUTES=15                  # a page refused by the daily limit waits this long before trying again
# VF_QUOTA_TZ=America/Los_Angeles     # the day the providers' daily quotas count in
# MATCH_PAUSE=30                      # seconds between the product matcher's calls when the text model is Z.ai's
# Ollama on this computer, as the containers reach it (a model at OLLAMA_URL/v1 is named ollama:<model>)
OLLAMA_URL=http://host.docker.internal:11434
# The older Gemini adapter (unused: Gemini is reached through https://generativelanguage.googleapis.com/v1beta/openai)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash

# ================================================================= browser tests (tests/browser/*.mjs, run by hand)
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# PUPPETEER=<path to puppeteer-core's lib/puppeteer/puppeteer-core.js>
# BASE=http://localhost:3002
