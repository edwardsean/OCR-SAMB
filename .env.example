# Copy to .env. Dev defaults only — never reuse these passwords outside your laptop.

POSTGRES_USER=ocr
POSTGRES_PASSWORD=ocr_dev_pw
POSTGRES_DB=ocr

RABBITMQ_USER=ocr
RABBITMQ_PASSWORD=ocr_dev_pw

MINIO_ROOT_USER=ocr
MINIO_ROOT_PASSWORD=ocr_dev_pw_minio
MINIO_BUCKET=scans

# Phase 3 — Jev (TypeSafe System One). Empty = keyword fallback classifier.
TYPESAFE_API_KEY=

# Phase 4 — VLM ("AI OCR"). Empty = Ollama qwen3-vl fallback.
# Free-tier Gemini inputs may be used by Google to improve models: sample data only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Phase 5 — verifier (different family from the VLM).
# Point at native Ollama on the Mac (Metal, much faster) with http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
VERIFIER_MODEL=qwen3:4b

# If the pinned model is overloaded (HTTP 503), these are tried in order. The model that answered is recorded per page.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash

# vlm-first (branch vlm-first). Free tiers: sample data only.
# AI OCR when VF_AI_OCR=groq:… (console.groq.com → API Keys).
GROQ_API_KEY=
# Teacher: GLM-4.6V-Flash, free on Z.ai's pay-as-you-go API. Create the key at https://z.ai/manage-apikey/apikey-list
# (no top-up needed for the free models). NOT the GLM Coding Plan (Lite/Pro/Max): that's a subscription for coding tools.
ZAI_API_KEY=
