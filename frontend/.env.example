# Copy to .env.local for `npm run dev` (Next.js reads it). In Docker, docker-compose.yml sets these instead.

# Where the API (services/api, FastAPI) answers, as this app's server sees it. Locally: the API's published port.
API_URL=http://localhost:8002

# The port `npm run dev` / `npm start` listens on (Next.js reads PORT from the shell: PORT=3002 npm run dev).
# PORT=3002
